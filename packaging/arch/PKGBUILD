# Maintainer: DevAyesh <https://github.com/DevAyesh>
pkgname=popcorn-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='A lightweight local movie and TV library with a built-in player (prebuilt binary)'
arch=('x86_64')
url='https://github.com/DevAyesh/Popcorn'
license=('GPL-3.0-only')
depends=(
  'gcc-libs'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'mpv'
  'webkit2gtk-4.1'
)
provides=('popcorn')
conflicts=('popcorn')
options=('!strip' '!debug')
source_x86_64=("${url}/releases/download/v${pkgver}/Popcorn_${pkgver}_linux_x86_64.tar.gz")
# Replace 'SKIP' with the tarball hash from the release's SHA256SUMS (or run `updpkgsums`)
# before generating .SRCINFO for the AUR.
sha256sums_x86_64=('SKIP')

package() {
  cd "${srcdir}/popcorn-${pkgver}-linux-x86_64"
  DESTDIR="${pkgdir}" PREFIX=/usr ./install.sh --no-check
}
